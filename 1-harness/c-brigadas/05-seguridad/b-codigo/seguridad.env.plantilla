# Seguridad (pieza 05): variables de entorno. Copiá este archivo a la carpeta de datos del servidor (junto a raphael.env)
# o cargalas desde la pantalla de Configuración. NUNCA pegues valores acá ni subas el archivo con valores a git.

# Consulta de dependencias vulnerables. off (default, no consulta nada) | osv (OSV.dev, gratis y sin clave: SALE el nombre y la
# versión de cada paquete) | mock (datos de prueba marcados SIMULADO).
SEGURIDAD_ADVISORIES=off

# Repos que se pueden auditar (rutas separadas por ';' en Windows o ':' en Linux). Solo estos: la brigada no lee otros.
# También se puede poner en la config de la brigada: brigades.seguridad.config.repos
SEGURIDAD_REPOS=

# --- Pentest activo (SOLO en la PC de Damián, nunca en el VPS) ---
# Lista de objetivos autorizados más allá de la red privada/loopback/Tailscale. La editás VOS a mano (ver authorized_targets.yaml.plantilla).
SEGURIDAD_TARGETS_FILE=
# real (default: usa los programas instalados; si faltan, avisa) | mock (resultados fijos marcados SIMULADO)
SEGURIDAD_PENTEST_ADAPTER=real
# Rutas de los programas si no están en el PATH (nmap y sqlmap):
NMAP_PATH=
SQLMAP_PATH=
# ZAP corriendo en modo daemon en tu PC: dirección y clave de su API (la clave la elegís vos al arrancar ZAP).
ZAP_URL=http://127.0.0.1:8080
ZAP_API_KEY=

# --- Vigilancia defensiva ---
# real (default) | mock. Qué se vigila va en la config de la brigada (watch: tls_hosts, services, backups, tokens), ver README.
SEGURIDAD_WATCH_ADAPTER=real

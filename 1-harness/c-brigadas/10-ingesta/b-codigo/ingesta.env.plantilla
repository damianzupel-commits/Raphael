# Ingesta (pieza 10). Copiá este archivo a la carpeta de datos (donde está raphael.env) como `ingesta.env` y completá lo que quieras.
# Nada de esto es obligatorio para que la brigada ande: sin nada, YouTube/web/arXiv leen en modo real, las notas quedan en
# el almacén de la brigada y los resúmenes salen por reglas. NUNCA subas este archivo con valores a git.

# Carpeta del vault (Markdown, compatible con Obsidian). Las notas van a <carpeta>/Ingesta/<fuente>/.
# Vacía = las notas quedan solo en el almacén de la brigada (y se publican por el evento nota.ingerida).
RAPHAEL_VAULT_DIR=

# YouTube: solo si pide "confirmar que no sos un bot". Una de las dos (la de archivo es la que anda en Windows):
#   YT_COOKIES_FILE=ruta a un cookies.txt exportado del navegador
#   YT_COOKIES_BROWSER=firefox
YT_COOKIES_FILE=
YT_COOKIES_BROWSER=

# La IA que resume NO se configura acá: sale del harness (rol `cocinero` de modelos.yaml; la clave de ese proveedor va en raphael.env). En Raphael personal la nube es NVIDIA (NVIDIA_API_KEY); el proveedor se cambia en modelos.yaml, no acá. Sin clave,
# el resumen sale por reglas y la nota lo dice.

# --- Fuentes públicas (papers, noticias, datos de conflicto y economía) ---
# Cada pedido a una fuente identifica a Raphael con este email (OpenAlex y Crossref lo piden o lo recomiendan). Va SOLO en este
# archivo de tu PC: nunca en el repo ni en el chat.
INGESTA_CONTACTO_EMAIL=
# Obligatorias para su fuente (sin ellas esa fuente no se llama; las demás andan igual):
FRED_API_KEY=          # clave de FRED (se pide con una cuenta en fredaccount.stlouisfed.org)
RELIEFWEB_APPNAME=     # appname de ReliefWeb (se pide con un formulario corto; responden por mail)
UCDP_TOKEN=            # token de UCDP (se pide por mail al mantenedor de la API; tarda 3 a 5 días hábiles)
# Opcionales:
OPENALEX_API_KEY=      # clave gratis de OpenAlex (sube el presupuesto diario; sin ella anda igual)
UCDP_VERSION=          # versión de la base de eventos de UCDP (por defecto 26.1)

# Plantilla de variables de la brigada Legales (pieza 16). Copiá a `.env` en el servidor y completá.
# NO pongas claves reales en el repo ni en el chat. Todo es opcional: sin nada, los borradores salen con [COMPLETAR: ...]
# y las normas quedan "sin verificar" hasta que haya red.

# --- Datos del negocio (salen en términos, privacidad, presupuestos, contratos y cartas) ---
# Tu config de la instalación (brigades.legales.config.negocio) pisa estas variables.
LEGALES_NEGOCIO_NOMBRE=
LEGALES_NEGOCIO_CUIT=
LEGALES_NEGOCIO_DOMICILIO=
LEGALES_NEGOCIO_EMAIL=
LEGALES_NEGOCIO_TELEFONO=
LEGALES_NEGOCIO_JURISDICCION=Argentina

# --- Consulta de fuentes oficiales (páginas públicas: no necesitan clave) ---
# real = consulta de verdad · mock = simulada (solo pruebas) · off = apagada (todo sale "sin verificar")
LEGALES_FUENTES_MODO=real
LEGALES_FUENTES_TIMEOUT=10

# --- Modelo de IA (opcional, lo comparte todo Raphael; no es propio de Legales) ---
# Con clave: segunda lectura de riesgos y redacción de cartas. Sin clave: reglas y plantillas, y lo avisa.
# OPENROUTER_API_KEY=

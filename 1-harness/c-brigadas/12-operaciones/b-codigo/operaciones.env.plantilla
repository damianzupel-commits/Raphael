# Operaciones (pieza 12): plantilla de variables. Copiala como `operaciones.env` (queda fuera de git) o pegá estas
# líneas en el archivo de claves del servidor (`raphael.env`) y completá SOLO lo que quieras usar.
# Acá no hay claves de IA: el modelo local se configura en modelos.yaml (ver LIENZO-DAMIAN.md).
# Listas: separadas con `;`. Sí/no: si | no.

# --- el interruptor principal ---------------------------------------------------------------------------------
# simulado = no toca nada (anota lo que haría). real = toca la PC y el celular de verdad (igual todo pide aprobación).
OPERACIONES_ADAPTADORES=simulado

# --- modo y carpetas -------------------------------------------------------------------------------------------
# autonomo (por defecto) = solo la carpeta segura; supervisado = además las carpetas de OPERACIONES_FS_SUPERVISADO.
OPERACIONES_MODO=autonomo
# OPERACIONES_CARPETA_SEGURA=D:\Raphael Ultimate\carpeta-segura
# OPERACIONES_FS_RAICES=
# OPERACIONES_FS_SUPERVISADO=C:\Users\TU_USUARIO
# Carpetas que NINGUNA tool lee, aunque estén dentro de una raíz (material personal):
# OPERACIONES_FS_PROHIBIDAS=
OPERACIONES_FS_PERMITIR_BORRAR=no

# --- interruptores del modo real (todos apagados por defecto) ----------------------------------------------------
OPERACIONES_PC_SHELL=no
OPERACIONES_ESCRITORIO=no
OPERACIONES_CELULAR_SHELL=no
OPERACIONES_CELULAR_CAMARA=no
# OPERACIONES_CELULAR_TIMEOUT=30

# --- navegador y web --------------------------------------------------------------------------------------------
OPERACIONES_NAVEGADOR_HEADLESS=si
# Si el Chromium de Playwright no arranca en tu PC, usá el Edge del sistema:
# OPERACIONES_NAVEGADOR_CANAL=msedge
# OPERACIONES_WEB_VETADOS=
OPERACIONES_WEB_RED_LOCAL=no
# Proxies para el último escalón de web_get (opcional): http://usuario:clave@host:puerto
# OPERACIONES_WEB_PROXIES=

# --- supervisor (revisa cada acción con el modelo local; falla abierto) ------------------------------------------
OPERACIONES_SUPERVISOR=no

# --- iniciar sesión en sitios (opcional) --------------------------------------------------------------------------
# 1) Los sitios permitidos:
# OPERACIONES_WEB_LOGIN_PERMITIDOS=tradingview.com
# 2) La credencial de cada uno (dominio en mayúsculas, lo que no es letra o número pasa a _). NUNCA por el chat:
# OPERACIONES_CRED_TRADINGVIEW_COM_USUARIO=
# OPERACIONES_CRED_TRADINGVIEW_COM_CLAVE=

# Trading (pieza 11): variables de entorno. Copiá estas líneas a `raphael.env` (fuera de git) o cargalas desde Configuración.
# NO hay claves: el login a Interactive Brokers lo hace IB Gateway/TWS abierto en tu PC. Sin nada de esto Trading corre
# contra el broker y los datos simulados y lo avisa. Pasos completos: 1-harness/c-brigadas/11-trading/a-historia/ibkr-pasos.md
# Dirección de IB Gateway o TWS (esta PC).
IBKR_HOST=127.0.0.1
# 4002 = IB Gateway paper (por defecto), 7497 = TWS paper. 4001 / 7496 son las de cuenta REAL: no las uses todavía.
IBKR_PORT=4002
# Un número cualquiera, distinto de otros programas conectados a la misma TWS.
IBKR_CLIENT_ID=7
# Tu cuenta PAPER (empieza con DU). En modo practice se rechaza una cuenta que no empiece con DU.
IBKR_ACCOUNT=
# ⚠ NO TOCAR. Candado extra para operar en cuenta REAL: debe quedar en 0. Subirlo a 1 es una decisión tuya, a conciencia,
# cuando ya hayas probado todo en paper. Aun así, toda orden sigue pidiendo tu aprobación.
TRADING_ALLOW_LIVE=0

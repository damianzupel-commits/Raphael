# Brigada Geolocalización (pieza 08). Copiá este archivo como geolocalizacion.env (queda fuera de git) o cargá las variables donde
# arranque Raphael. NUNCA pegues una clave real en el chat ni en el repo. Todo esto es opcional: sin una clave, esa capa
# avisa cuál falta y devuelve vacío. Las capas libres (terremotos, noticias, ISS, satélites, datacenters, cables, vuelos)
# y la geolocalización de IPs y cripto no piden ninguna.

# --- modo (opcional) ---
# real = internet (por defecto) · simulado = datos de muestra marcados como tales, sin red ni claves
# RAPHAEL_GEO_MODO=real

# --- Shodan (buscar hosts expuestos; gasta cupo de la cuenta, por eso pide tu OK) ---
# Se saca en: https://account.shodan.io  (la búsqueda por API exige cuenta paga o con créditos)
SHODAN_KEY=

# --- Barcos (AISStream, gratis con cuenta; necesita `pip install websockets`) ---
# Se saca en: https://aisstream.io
AISSTREAM_KEY=

# --- Incendios activos (NASA FIRMS, gratis) ---
# Se saca en: https://firms.modaps.eosdis.nasa.gov/api/map_key
FIRMS_MAP_KEY=

# --- Cámaras públicas (Windy Webcams, gratis) ---
# Se saca en: https://api.windy.com/keys
WINDY_WEBCAMS_KEY=

# --- Clima de ciudades grandes (OpenWeather, gratis) ---
# Se saca en: https://home.openweathermap.org/api_keys
OPENWEATHER_KEY=

# --- Antenas de celular (OpenCelliD, gratis con cuenta; su API es por área, no global) ---
# Se saca en: https://opencellid.org
OPENCELLID_KEY=
# Área a consultar: lat_sur,lon_oeste,lat_norte,lon_este  (ejemplo: Rosario)
OPENCELLID_BBOX=

# Brigada Contenido (pieza 14): variables de entorno. Copiá este archivo a `.env` (NO se sube a git), completá lo que tengas y reiniciá.
# Sin una clave, esa parte avisa qué falta y el resto de la brigada anda igual. Nunca pegues claves en un chat.

# `mock` fuerza todo simulado (demo y pruebas); vacío = real si están las claves
CONTENIDO_MODO=

# id numérico de la cuenta profesional de Instagram. Se saca de Meta for Developers > tu app > Instagram > cuenta profesional conectada (id numérico).
IG_USER_ID=

# token de acceso de Meta con permiso de publicar y leer métricas. Se saca de Meta for Developers > tu app > generar token con instagram_content_publish e instagram_manage_insights.
IG_ACCESS_TOKEN=

# versión de la Graph API (por defecto v21.0)
IG_GRAPH_VERSION=

# id de la cuenta publicitaria (act_...). Se saca del Administrador de anuncios de Meta (id de cuenta, con o sin act_).
META_ADS_ACCOUNT_ID=

# token con permiso de ads_management. Token de Meta con permiso ads_management.
META_ADS_ACCESS_TOKEN=

# dirección de ComfyUI en esta PC (por defecto http://127.0.0.1:8188)
COMFYUI_URL=

# carpeta `output` de ComfyUI, de donde se leen las imágenes y videos generados
COMFYUI_OUTPUT_DIR=

# carpeta fija de trabajo de video (entrada/ y salida/); por defecto Documentos/Videos-Raphael
VIDEO_EDIT_DIR=

# ruta de ffmpeg si no está en el PATH
VIDEO_FFMPEG_PATH=

# hilos de ffmpeg (por defecto la mitad de los núcleos, hasta 4)
VIDEO_FFMPEG_THREADS=

# tope de cada trabajo de ffmpeg (por defecto 1800)
VIDEO_FFMPEG_TIMEOUT_SECONDS=

# modelo de faster-whisper para transcribir (por defecto small)
VIDEO_WHISPER_MODEL=

# intérprete con faster-whisper, si no es el actual
VIDEO_WHISPER_PYTHON=

# tope de una grabación de pantalla (por defecto 300)
VIDEO_GRABACION_MAX_SECONDS=

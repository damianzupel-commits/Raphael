# Lo que el ORQUESTADOR necesita de Damián. Copiá como `orquestador.env` (o sumalo a tu `raphael.env`) y completá lo que tengas.
# NUNCA subir a GitHub ni pegar en un chat. Todo lo que quede vacío no rompe nada: cae a reglas/plantilla y lo avisa.
# Lista completa y qué probar después: 3-mando/a-conocimiento/LIENZO-DAMIAN.md (la arma el coordinador).

# ---- Modelos de IA (los usa la pasarela del harness; el orquestador solo pide roles: mando, voz, ruteo) -------------------
# Nube, para lo que NO es sensible (Raphael personal): clave de NVIDIA (build.nvidia.com). Ojo: sus términos solo permiten
# desarrollo y pruebas; que Damián la use solo para su Raphael personal es un SUPUESTO a verificar (ver CONTEXT.md §6).
NVIDIA_API_KEY=
# Nube para Raphael Empresas (tráfico de clientes): OpenRouter, ya decidido.
OPENROUTER_API_KEY=

# ---- Modelo LOCAL para lo sensible (Seguridad, Investigación, Memoria, Operaciones) -----------------------------------------
# No lleva clave: se declara como proveedor en el escalón `local` de modelos (ver modelos.personal.ejemplo.yaml), apuntando
# a Ollama (http://localhost:11434/v1) o LM Studio (http://localhost:1234/v1). Hay que tener el programa PRENDIDO y el modelo
# bajado. Si no está prendido, el orquestador avisa y lo sensible NO se manda a la nube.

# ---- Voz hablada (opcional; todo local, sin red) ---------------------------------------------------------------------------
# auto = local si están los paquetes y la voz, si no apagada y lo avisa · local · mock (simulada) · off
RAPHAEL_VOZ_MODO=auto
# 0 apaga la voz hablada del todo.
VOICE_ENABLED=1
# Intérprete de Python que tenga `pip install faster-whisper piper-tts` (vacío = el que corre Raphael, si ya los tiene).
VOICE_PYTHON=
# Ruta al .onnx de la voz es-AR de Piper (es_AR-daniela-high.onnx, con su .onnx.json al lado):
# huggingface.co/rhasspy/piper-voices > es > es_AR > daniela > high
VOICE_PIPER_VOICE=
# Whisper para oír: small va bien en CPU. Se baja UNA vez (Systran/faster-whisper-small en Hugging Face) y después corre sin red.
VOICE_STT_MODEL=small
VOICE_STT_DEVICE=cpu
VOICE_STT_COMPUTE=int8
VOICE_STT_LANG=es
VOICE_TTS_SPEED=1.0

# Claves de Raphael Empresas. UN solo archivo para todo.
# Copiá este archivo como `raphael.env` en la carpeta de datos (en la PC de Damián: .data\empresas\) y completá lo que tengas.
# NUNCA subir a GitHub ni pegar en un chat. Lo que quede vacío no rompe nada: el sistema cae a reglas o a modo mock.
# Para ver qué falta:  2-entrega\c-despliegue\windows\arrancar.bat chequear
# Detalle de cada una: 2-entrega/c-despliegue/QUE-CARGAR.md

# ---- IA (OpenRouter) ---------------------------------------------------------------------------------------------
# openrouter.ai > Keys. Empieza con sk-or-. Sin ella la Secretaria y el ruteo responden por reglas.
OPENROUTER_API_KEY=
# Solo para pruebas de desarrollo (sus términos no permiten clientes reales). Ningún escalón la usa por defecto.
# NVIDIA_API_KEY=

# ---- Meta: WhatsApp e Instagram ------------------------------------------------------------------------------------
# mock = no manda nada a nadie (para probar) · real = manda de verdad. Pasar a real recién con todo lo de abajo cargado.
META_MODE=mock
# Lo inventás vos (texto largo cualquiera) y lo pegás igual en la app de Meta al configurar el webhook.
META_VERIFY_TOKEN=
# "Clave secreta de la app" (developers.facebook.com > tu app > Configuración > Básica). Verifica la firma de cada webhook.
META_APP_SECRET=
# WhatsApp Cloud API: token permanente del usuario del sistema y el Phone number ID del número.
META_WA_TOKEN=
META_WA_PHONE_ID=
# Instagram API with Instagram Login: token de usuario de la cuenta profesional.
META_IG_TOKEN=
# graph.instagram.com (cuenta sin página de Facebook) o graph.facebook.com (cuenta vinculada a una página).
META_IG_HOST=graph.instagram.com
META_GRAPH_VERSION=v26.0

# ---- Dirección pública (solo para que el chequeo te muestre el webhook que hay que pegar en Meta) ------------------------
# Con Tailscale Funnel es https://<tu-pc>.<tu-tailnet>.ts.net  (la ves con: tailscale funnel status). Sin barra al final.
RAPHAEL_PUBLIC_URL=

# ---- Tienda de la clienta (solo si usa Tiendanube, Shopify o WooCommerce; con feed JSON/CSV o sin tienda no hace falta) ---
TIENDANUBE_TOKEN=
SHOPIFY_TOKEN=
WOO_KEY=
WOO_SECRET=

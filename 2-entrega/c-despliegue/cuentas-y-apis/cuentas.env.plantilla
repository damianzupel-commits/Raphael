# Claves y datos de cuentas de Raphael (pieza 4 · Cuentas y APIs). GENERADO desde catalogo.py: no editar a mano.
# Copiá como `raphael.env` en la carpeta de datos (PC de Damián: .data\empresas\) y completá lo que tengas.
# NUNCA subir a GitHub ni pegar en un chat. Lo que quede vacío no rompe nada: Raphael cae a reglas o a modo mock.
# Ver qué falta: python -m raphael_cuentas chequear      Probar en vivo (solo lectura): python -m raphael_cuentas probar

# ---- OpenRouter (IA en la nube) [ambas] --------
# Dónde se saca: openrouter.ai → Keys → Create key (empieza con sk-or-). El saldo ya lo cargaste.
# OPENROUTER_API_KEY: Empieza con sk-or-
OPENROUTER_API_KEY=

# ---- NVIDIA build.nvidia.com (opcional, sin usar) [personal] --------
# Dónde se saca: build.nvidia.com → iniciar sesión → cualquier modelo → Get API Key (empieza con nvapi-).
# NVIDIA_API_KEY: Empieza con nvapi-
NVIDIA_API_KEY=

# ---- Modelo local (Ollama o LM Studio en tu PC) [personal] --------
# Dónde se saca: Instalá Ollama (ollama.com) o LM Studio (lmstudio.ai) y bajá un modelo. No lleva clave.
# LOCAL_LLM_URL: Ollama: http://127.0.0.1:11434 · LM Studio: http://127.0.0.1:1234
LOCAL_LLM_URL=http://127.0.0.1:11434
# LOCAL_LLM_KIND: ollama o lmstudio
LOCAL_LLM_KIND=ollama

# ---- Meta · app y webhook [empresas] --------
# Dónde se saca: developers.facebook.com → crear app (tipo Business) → Configuración → Básica (clave secreta). El token de verificación lo inventás vos.
# META_VERIFY_TOKEN: Texto largo inventado por vos
META_VERIFY_TOKEN=
META_APP_SECRET=
# META_MODE: mock o real
META_MODE=mock

# ---- WhatsApp Cloud API (número de prueba) [empresas] --------
# Dónde se saca: Meta Business → Usuarios del sistema → generar token permanente; WhatsApp → Configuración de la API → Phone number ID del número de prueba.
META_WA_TOKEN=
META_WA_PHONE_ID=
META_GRAPH_VERSION=v26.0

# ---- Instagram (mensajes directos) [empresas] (opcional) --------
# Dónde se saca: developers.facebook.com → tu app → Instagram API with Instagram Login → generar token de la cuenta profesional de prueba.
META_IG_TOKEN=
# META_IG_HOST: graph.instagram.com o graph.facebook.com
META_IG_HOST=graph.instagram.com

# ---- Mercado Pago (cobros de Empresas) [empresas] --------
# Dónde se saca: mercadopago.com.ar/developers → Tus integraciones → crear aplicación → Credenciales (Access Token de prueba primero, después el de producción).
MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET: Para firmar los avisos de pago
MP_WEBHOOK_SECRET=
# MP_MODE: mock o real
MP_MODE=mock

# ---- Transferencia bancaria (datos de la cuenta de la dueña) [empresas] --------
# Dónde se saca: Los datos de la cuenta de la dueña (los pasa ella).
TRANSFER_TITULAR=
# TRANSFER_CBU_CVU: 22 dígitos
TRANSFER_CBU_CVU=
TRANSFER_ALIAS=
TRANSFER_BANCO=

# ---- Tailscale Funnel (túnel hasta el VPS) [ambas] --------
# Dónde se saca: Ya está andando: `tailscale funnel status` muestra la URL (https://<pc>.<tailnet>.ts.net).
RAPHAEL_PUBLIC_URL=

# ---- DuckDNS (dominio gratis para el VPS) [empresas] (opcional) --------
# Dónde se saca: duckdns.org → iniciar sesión → crear subdominio; el token está arriba en la página.
DUCKDNS_TOKEN=
# DUCKDNS_DOMAIN: Solo el subdominio, sin .duckdns.org
DUCKDNS_DOMAIN=

# ---- Hetzner (VPS) [empresas] (opcional) --------
# Dónde se saca: console.hetzner.cloud → proyecto → Seguridad → Tokens de API (lectura y escritura). No abrir la cuenta hasta que haya con qué pagar.
HCLOUD_TOKEN=

# ---- Tienda de la clienta (Tiendanube, Shopify o WooCommerce) [empresas] (opcional) --------
# Dónde se saca: El panel de la tienda de la clienta (ella autoriza).
TIENDANUBE_TOKEN=
SHOPIFY_TOKEN=
WOO_KEY=
WOO_SECRET=


# Canal de Meta de Raphael Empresas. NUNCA subir a GitHub ni compartir. Lo lee el servicio al arrancar.
# mock = no manda nada a WhatsApp ni a Instagram (para probar) · real = manda de verdad
META_MODE=mock
# Lo inventás vos (cualquier texto largo) y lo pegás igual en la app de Meta al configurar el webhook
META_VERIFY_TOKEN=
# "Clave secreta de la app" (Configuración básica de la app en developers.facebook.com): verifica que el webhook sea de Meta
META_APP_SECRET=
# WhatsApp Cloud API: token permanente del usuario del sistema y el id del número (Phone number ID)
META_WA_TOKEN=
META_WA_PHONE_ID=
# Instagram API with Instagram Login: token de usuario de Instagram de la cuenta profesional
META_IG_TOKEN=
# graph.instagram.com (cuenta sin página de Facebook) o graph.facebook.com (cuenta vinculada a una página)
META_IG_HOST=graph.instagram.com
META_GRAPH_VERSION=v26.0
# Proveedor de IA de la v1 (NVIDIA): lo carga Damián en el VPS, nunca por chat. Descomentar y completar. Sin esto el harness degrada a reglas y lo avisa.
# NVIDIA_API_KEY=

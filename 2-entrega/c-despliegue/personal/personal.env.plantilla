# Claves de Raphael PERSONAL. Copiá este archivo como .data\personal\raphael.env (se crea solo la primera vez) y completá
# lo que tengas, o mejor: cargalo desde la pantalla de Configuración de la app (no hace falta editar archivos).
# NUNCA subir a GitHub ni pegar en un chat. Lo que quede vacío no rompe nada: ese rol cae a reglas y el chequeo lo avisa.
# Detalle de cada una y qué probar después: 3-mando/a-conocimiento/LIENZO-DAMIAN.md

# ---- IA en la nube (lo que no es privado) --------------------------------------------------------------------------
# build.nvidia.com → Get API Key (nvapi-…). Gratis para uso tuyo personal.
NVIDIA_API_KEY=
# Opcional: solo si querés que un rol use el escalón pago (OpenRouter) y subís paid_cap_usd_month.
OPENROUTER_API_KEY=

# ---- IA local (lo privado: Seguridad, Investigación, Memoria y Operaciones) ------------------------------------------
# Ollama (ollama.com) o LM Studio (lmstudio.ai), prendido en esta PC con un modelo bajado. Sin clave.
# Direcciones por defecto: Ollama http://127.0.0.1:11434 · LM Studio http://127.0.0.1:1234 (solo localhost).
LOCAL_LLM_URL=
LOCAL_LLM_KIND=
# El modelo: el de `ollama list` / el cargado en LM Studio.
OLLAMA_MODEL=
LMSTUDIO_MODEL=

# ---- Qué modelo usa cada rol (opcional; vacío = lo de modelos.personal.yaml) ----------------------------------------
# Escalones en orden: local, gratis, pago. Ej.: RAPHAEL_ROL_MANDO=local,gratis
RAPHAEL_ROL_MANDO=
RAPHAEL_ROL_VOZ=
RAPHAEL_ROL_JEFE=
RAPHAEL_ROL_RUTEO=
RAPHAEL_ROL_COCINERO=
RAPHAEL_ROL_EFIMERO=
# Brigadas extra que quedan solo en local, además de las cuatro de siempre. Ej.: trading,legales
RAPHAEL_PRIVADAS=

# ---- Celular y voz ---------------------------------------------------------------------------------------------------
# La dirección https://…ts.net que muestra celular-tailscale.bat.
RAPHAEL_PUBLIC_URL=
# auto, local, mock u off (voz hablada local; ver el orquestador).
RAPHAEL_VOZ_MODO=

# ---- Otras cuentas (opcionales; ver cuentas-y-apis) --------------------------------------------------------------------
DUCKDNS_TOKEN=
DUCKDNS_DOMAIN=
HCLOUD_TOKEN=

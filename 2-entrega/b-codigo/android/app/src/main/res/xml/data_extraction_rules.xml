<?xml version="1.0" encoding="utf-8"?>
<!-- La sesión no se respalda ni se copia a otro equipo: hay que volver a entrar con la clave. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>

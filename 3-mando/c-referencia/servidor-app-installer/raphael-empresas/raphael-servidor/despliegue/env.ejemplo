# Copiar a datos/.env y completar. Nunca subir este archivo a GitHub.
RAPHAEL_MODO=mock                 # mock (no manda nada) | real (WhatsApp/Instagram de verdad)
RAPHAEL_LICENCIA=RAPH-XXXX-XXXX-XXXX
RAPHAEL_CENTRAL_URL=https://central.tudominio.com
RAPHAEL_RELAY_URL=https://relay.tudominio.com
RAPHAEL_RELAY_TOKEN=                # el mismo token de esta instalación en instalaciones.yaml del relay
WHATSAPP_TOKEN=                     # token permanente de la app de Meta (System User)
WHATSAPP_PHONE_ID=
INSTAGRAM_TOKEN=
META_GRAPH_VERSION=v21.0
RAPHAEL_CLAVE_BACKUP=               # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Claves de IA según el plan (ver raphael-harness/src/raphael_harness/modelos.yaml)
RAPHAEL_IA_ECONOMICO_KEY=
RAPHAEL_IA_BUENO_KEY=

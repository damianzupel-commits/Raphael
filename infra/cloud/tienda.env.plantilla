# Tokens de la tienda de la clienta (solo si usa Tiendanube, Shopify o WooCommerce; con un feed JSON/CSV no hace falta).
# NUNCA subir a GitHub. En la instalación va solo el NOMBRE de la variable (store.source.token_env / secret_env).
# Tiendanube: token de acceso de la app instalada en su tienda
TIENDANUBE_TOKEN=
# Shopify: token de la app personalizada (Admin API, permiso de lectura de productos)
SHOPIFY_TOKEN=
# WooCommerce: Ajustes > Avanzado > API REST > clave de solo lectura
WOO_KEY=
WOO_SECRET=

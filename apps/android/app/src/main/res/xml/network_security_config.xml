<?xml version="1.0" encoding="utf-8"?>
<!-- Release: solo HTTPS (con los certificados del sistema). La variante debug suma http para la red local. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
